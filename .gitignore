# Python / editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*
!.env.example
.idea/
.vscode/
*.egg-info/
build/
dist/

# Research data must be downloaded separately (never version raw records)
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated models, metrics and visualizations
/artifacts/models/*
!/artifacts/models/.gitkeep
/artifacts/reports/*
!/artifacts/reports/.gitkeep

# Local caches and credential material
*.pem
*.key
*.p12
*.pfx
.DS_Store

# Optional local Streamlit credentials
.streamlit/secrets.toml
